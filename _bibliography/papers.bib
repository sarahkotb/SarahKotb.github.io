@article{kotb2025msp,
  abbr={JAMA Netw Open},
  title={Medicare Savings Program Take-Up Estimates and Profile of Enrolled and Unenrolled Individuals},
  author={Kotb, Sarah and Su, Amanda and Sinaiko, Anna D.},
  journal={JAMA Network Open},
  volume={8},
  number={10},
  pages={e2535408},
  year={2025},
  publisher={American Medical Association},
  doi={10.1001/jamanetworkopen.2025.35408},
  html={https://doi.org/10.1001/jamanetworkopen.2025.35408},
  selected={true},
  bibtex_show={true},
  abstract={Cross-sectional study estimating national and state-level take-up of the Medicare Savings Programs (MSPs) from 2018--2020 and characterizing enrolled versus unenrolled eligible individuals. About 56.7\% of eligible beneficiaries were enrolled; enrollees had worse health, lower income, and fewer assets than eligible non-enrollees, suggesting the MSPs are reaching those with greater financial and health insecurity.}
}

@article{cranor2019eitc,
  abbr={Natl Tax J},
  title={Does Informing Employees about Tax Benefits Increase Take-Up? Evidence from {EITC} Notification Laws},
  author={Cranor, Taylor and Goldin, Jacob and Kotb, Sarah},
  journal={National Tax Journal},
  volume={72},
  number={2},
  pages={397--434},
  year={2019},
  publisher={University of Chicago Press},
  doi={10.17310/ntj.2019.2.04},
  html={https://doi.org/10.17310/ntj.2019.2.04},
  selected={true},
  bibtex_show={true},
  abstract={We use state and time variation in the adoption of employer EITC notification requirements, linked to administrative tax data, to estimate their effect on EITC claiming, filing behavior, and labor force participation. We find precise null effects, casting doubt on the effectiveness of the notice requirements as implemented.}
}

